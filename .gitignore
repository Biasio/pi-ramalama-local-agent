# Config locali derivate dai template .conf.example in conf/
conf/*.conf
!conf/env.conf
!conf/*.conf.example

# Override generato automaticamente da render_mounts()
compose.mounts.override.yaml

# Auto-generated per-session by 'pi-ramalama --start' (shadow models.json
# mount) — torn down when the session ends
compose.session.override.yaml

hooks.d/post-start
