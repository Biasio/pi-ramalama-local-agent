#!/bin/bash
# pi-ramalama: CLI dispatcher. No logic of its own; behaviour lives in:
#   lib/common.sh     engine/compose, prompts, host deps, healthcheck, ports
#   lib/env.sh        host bootstrap, mounts, extensions, teardown
#   lib/model.sh      pull/benchmark/remove model, MODEL_PARAMS bookkeeping
#   lib/session.sh    router serve, TUI and RPC session lifecycle
#   lib/pi-wrapper.sh host 'pi' proxy (symlinked to ~/.local/bin/pi)
#   python/*.py       JSON merge and benchmark parsing, run inside containers
set -e

DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
CONFIG_FILE="$DIR/conf/env.conf"
MODELS_CONFIG_FILE="$DIR/conf/models.conf"

for module in common env model session; do source "$DIR/lib/$module.sh"; done

declare -A MODEL_PARAMS
[ -f "$MODELS_CONFIG_FILE" ] || echo 'declare -A MODEL_PARAMS' > "$MODELS_CONFIG_FILE"
[ -f "$CONFIG_FILE" ] && source "$CONFIG_FILE"
source "$MODELS_CONFIG_FILE"

check_dependencies || exit 1

case "$1" in
    --setup|--install)   ensure_environment ;;
    --render-mounts)     render_mounts ;;
    --install-extensions) install_extensions ;;
    --start)             start_env "${@:2}" ;;
    --start-rpc)         start_rpc ;;
    --start-rpc-async)   start_rpc_async ;;
    --stop-rpc)          stop_rpc ;;
    --pull)              pull_model "${2:-}" ;;
    --benchmark)         benchmark_cli "${2:-}" ;;
    --rm-model)          remove_model ;;
    --remove)            remove_env ;;
    *)
        cat << 'USAGE'
Usage: pi-ramalama <command> [args]

First-time setup, in order:
  --setup                     bootstrap the host (dirs, pi wrapper, build image)
  --pull <model_uri>          download a model via ramalama, optionally benchmark it
  --install-extensions        run conf/pi-extensions.conf inside pi-agent (optional)
  --start [pi args]           serve every local model, attach to pi-agent in TUI

Model management:
  --benchmark [model_uri]     (re)run the isolated param benchmark on a pulled model
  --rm-model                  remove a pulled model and its saved params

RPC (used by the pi wrapper for VSCode; you normally don't call these directly):
  --start-rpc                 blocking bootstrap, waits for the model to load
  --start-rpc-async           non-blocking bootstrap, used by 'pi --mode rpc'
  --stop-rpc                  tears down ramalama/pi-agent if no RPC session is left

Maintenance:
  --render-mounts             re-render conf/pi-mounts.conf into a compose override
  --remove                    destroy containers, volumes and built images

Config lives in conf/: copy the *.example files and edit them before
running --setup. See README.md for the full picture.
USAGE
        exit 1
        ;;
esac
